  "protectedRoomLeaves": [
    "Room/Name",
    "Room/FloorGridID",
    "Room/WallGridIDs",
    "Room/RoomPrefabAddress",
    "Room/Ceiling"
  ],
  "invariants": [
    "PlayerHouses length/order preserved",
    "target HouseItemID preserved",
    "Floors length/order preserved",
    "Rooms membership preserved",
    "all GridObject identities/payloads preserved",
    "only semantic-owner-declared allowed room leaf paths may change",
    "GameInfo and unrelated/opaque state preserved"
  ],
  "explicitlyNotSupported": [
    "generic PlayerHouses writer",
    "arbitrary JSON Patch",
    "House/Floor/Room create/delete/reorder",
    "Ceiling write",
    "GridObject mutation",
    "persistent source replacement",
    "Steam inheritance"
  ],
  "hardFlags": {
    "persistentWriteAuthorized": false,
    "WORLD_PERSISTENT_WRITE_V125": false,
    "PERSISTENT_WRITE": false,
    "productApplyAuthorized": false,
    "directSourceReplacementAuthorized": false
  }
