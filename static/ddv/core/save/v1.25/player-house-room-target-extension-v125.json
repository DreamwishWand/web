  },
  "upstreamRequest": "01B-TO-01A-ROOM-FINISH-TARGET-V125-V1",
  "capability": "WRITE_CANDIDATE",
  "targetKind": "PLAYER_HOUSE_ROOM",
  "targetIdentity": {
    "required": [
      "playerHouseIndex",
      "houseItemId",
      "floorIndex",
      "roomSlot"
    ],
    "roomSlotRange": [
      0,
      3
    ],
    "playerHouseIndex": "current-save locator only",
    "houseItemId": "semantic binding required before and after"
  },
  "allowedRoomFinishLeaves": [
    "Room/Flooring",
    "Room/Wallpapers/{WallPosition 0..3}",
    "Room/WallpaperOffsetById/{WallpaperItemId}"
