        "when": {
          "characterHouse": true
        },
        "class": "SPECIAL_GRID_BUILDING",
        "reason": "CHARACTER_HOUSE_LIFECYCLE"
      },
      {
        "when": {
          "fastTravel": true
        },
        "class": "SPECIAL_GRID_BUILDING",
        "reason": "FAST_TRAVEL_WORLD_STATE"
      },
      {
        "when": {
          "sharedSynchronizer": true
        },
        "class": "SPECIAL_GRID_BUILDING",
        "reason": "SHARED_SYNCHRONIZED_STATE"
      },
      {
        "when": {
          "globalStateBinding": true
        },
        "class": "SPECIAL_GRID_BUILDING",
        "reason": "GLOBAL_STATE_BINDING"
      }
    ],
    "ordinaryRequirements": {
